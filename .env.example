# ──────────────────────────────────────────────────────────────────────────────
# .env.example — variáveis de ambiente do back-end.
# Copie este arquivo para .env e preencha os valores antes de iniciar o servidor.
# NUNCA versione o arquivo .env com as credenciais reais.
# ──────────────────────────────────────────────────────────────────────────────

# Porta do servidor HTTP (padrão: 5000)
PORT=5000

# Ambiente (development | production | test)
NODE_ENV=development

# ── Banco de dados SQLite ─────────────────────────────────────────────────────
# Caminho para o arquivo do banco. Em produção, use um volume persistente.
DB_CLIENT=sqlite3
DB_PATH=./data/canteiro.sqlite3

# ── JWT ───────────────────────────────────────────────────────────────────────
# OBRIGATÓRIO em produção. Use strings longas e aleatórias.
# Exemplo de geração: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=coloque_um_segredo_jwt_forte_aqui
JWT_REFRESH_SECRET=coloque_um_segredo_refresh_jwt_forte_aqui

# Expiração do access token (padrão: 15m)
JWT_EXPIRES_IN=15m

# Expiração do refresh token (padrão: 7d)
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────────────────────
# Lista de origens permitidas separadas por vírgula.
# Em desenvolvimento: http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Máximo de requisições gerais por IP a cada 15 minutos (padrão: 100)
RATE_LIMIT_MAX=100
# Máximo de tentativas de login por IP a cada 15 minutos (padrão: 10)
LOGIN_RATE_LIMIT_MAX=10
# Máximo de tentativas de refresh token por IP a cada 15 minutos (padrão: 30) (C-3)
REFRESH_RATE_LIMIT_MAX=30

# ── Upload de arquivos ────────────────────────────────────────────────────────
# Provedor de armazenamento: local | supabase
STORAGE_PROVIDER=local

# Pasta local de uploads (apenas quando STORAGE_PROVIDER=local)
UPLOAD_PATH=./uploads

# Tamanho máximo de arquivo em bytes (padrão: 5 MB = 5242880)
MAX_FILE_SIZE=5242880

# Tipos MIME permitidos separados por vírgula
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,application/pdf

# Qualidade da compressão de imagem 1-100 (padrão: 80)
IMAGE_COMPRESSION_QUALITY=80

# ── Supabase (apenas quando STORAGE_PROVIDER=supabase) ────────────────────────
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui
SUPABASE_BUCKET=arquivos

# ── Outros ───────────────────────────────────────────────────────────────────
# Limite do corpo JSON (padrão: 10mb)
JSON_BODY_LIMIT=10mb
